# Configuración de producción para el backend
# Copiar este archivo y renombrar a .env en el servidor

# Puerto del servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=drdesk_user
DB_PASSWORD=TU_CONTRASEÑA_SEGURA
DB_NAME=biodental

# JWT Secret (generar uno seguro)
JWT_SECRET=genera_un_secret_muy_largo_y_seguro_aqui

# Entorno
NODE_ENV=production

# CORS - URL del frontend
CORS_ORIGIN=localhost:3000
FRONTEND_URL=https://TU-DOMINIO

# WhatsApp (YCloud) - normalmente se configura desde Perfil > Administración > WhatsApp
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=
WHATSAPP_PREFIJO_PAIS=+52

# Google Calendar - cada doctor vincula su propia cuenta desde Perfil.
# Ver instrucciones en backend/.env.example. El redirect URI debe coincidir
# EXACTO con el registrado en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-DOMINIO/api/google-calendar/callback
