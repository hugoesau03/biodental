# Variables de entorno para Biodental Backend

# Servidor
PORT=5000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=biodental

# JWT
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# WhatsApp (YCloud) - confirmaciones y recordatorios de cita
# La forma normal de configurar esto es desde la app: Perfil > Administración
# > WhatsApp (solo admin, por consultorio). Estas variables son solo un
# respaldo/valor por defecto si no se configura desde ahí.
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=+5215500000000
WHATSAPP_PREFIJO_PAIS=+52
# Nombre de plantillas aprobadas en YCloud/Meta (opcional, recomendado en producción)
# Sin plantilla solo se puede enviar dentro de la ventana de 24h de WhatsApp
YCLOUD_TEMPLATE_CONFIRMACION=
YCLOUD_TEMPLATE_RECORDATORIO=
YCLOUD_TEMPLATE_LANG=es_MX

# Google Calendar - cada doctor vincula su propia cuenta desde Perfil.
# Ver instrucciones en backend/.env sobre cómo crear las credenciales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google-calendar/callback
