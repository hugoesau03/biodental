# Variables para docker-compose.yml — copiar a ".env" (mismo folder que docker-compose.yml)
# y rellenar con valores propios antes de "docker compose up -d".
# NUNCA reutilizar estos valores de ejemplo ni los de otro despliegue (drdesk).

# --- Base de datos ---
DB_NAME=biodental
DB_USER=biodental_user
DB_PASSWORD=genera_una_contraseña_segura_aqui
DB_ROOT_PASSWORD=genera_otra_contraseña_segura_para_root

# --- Backend / JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secret_largo_y_aleatorio_aqui

# --- CORS / URLs ---
# Dominio(s) desde los que se sirve el frontend (separados por coma si hay varios)
CORS_ORIGIN=http://localhost:8081
FRONTEND_URL=http://localhost:8081

# Puerto en el host donde queda expuesto el frontend (nginx adentro escucha 80)
HTTP_PORT=8081
PMA_PORT=8082

# --- WhatsApp (YCloud) — opcional, normalmente se configura desde la app ---
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=
WHATSAPP_PREFIJO_PAIS=+52

# --- Google Calendar — opcional, normalmente se configura desde la app (admin) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/google-calendar/callback
