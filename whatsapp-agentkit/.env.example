# Biodental — Asistente de WhatsApp — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Proveedor de WhatsApp ──────────────────────────────────
WHATSAPP_PROVIDER=ycloud

# ── API de Biodental (cuenta de servicio) ──────────────────
# URL de la API real de Biodental. Local (Docker): http://localhost:8081/api
# Producción: la URL pública del backend detrás de tu dominio.
BIODENTAL_API_URL=http://localhost:8081/api
BIODENTAL_AGENT_EMAIL=asistente-whatsapp@biodental.local
BIODENTAL_AGENT_PASSWORD=

# NOTA: la API Key de OpenAI y las credenciales de YCloud (API key,
# número emisor, secreto de webhook) NO se configuran aquí — el agente
# las lee en tiempo real de la app de Biodental (Perfil > Administración
# > Integraciones > "Asistente de WhatsApp con IA" y "WhatsApp (YCloud)"),
# donde además se prueban contra la API real antes de guardarse. Si no
# están configuradas ahí, el agente simplemente no responde — no hay
# variables de entorno de respaldo para eso.

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Zona horaria (para "hoy"/"mañana" al agendar) ──────────
ZONA_HORARIA=America/Mexico_City

# ── Base de datos (memoria de conversaciones del agente) ───
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
